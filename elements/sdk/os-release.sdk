kind: meson
sources:
- kind: local
  path: files/os-release
build-depends:
- gnome-build-meta.bst:freedesktop-sdk.bst:public-stacks/buildsystem-meson.bst
- gnome-build-meta.bst:freedesktop-sdk.bst:components/appstream-minimal.bst
depends:
- freedesktop-sdk.bst:public-stacks/runtime-minimal.bst
variables:
  meson-local: >-
    -Dbranch=%{branch}
    -Dmode=flatpak
